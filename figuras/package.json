{
  "name": "mis-figuras",
  "version": "1.0.0",
  "description": "Colección de figuras: compradas, pre-órdenes, deseadas y pagos pendientes. Ventana siempre encima.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.misfiguras.app",
    "productName": "Mis Figuras",
    "files": ["main.js", "preload.js", "src/**/*"]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
